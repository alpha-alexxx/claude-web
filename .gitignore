# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- dependencies -----------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- testing ----------------------------------------------------------------
/coverage

# --- app data (SQLite, integration env, render key, MCP registry) -----------
# Runtime state written by the server. Never commit: the DB holds chat
# history and the audit trail, integrations.env holds provider credentials.
/data/

# --- Next.js ----------------------------------------------------------------
/.next/
/out/
# next-env.d.ts is generated on dev/build; Next's docs say not to track it.
next-env.d.ts
*.tsbuildinfo

# --- production -------------------------------------------------------------
/build

# --- env files --------------------------------------------------------------
# `.env` holds Clerk keys and secrets; only the value-free template belongs in
# git, so a fresh checkout knows which variables exist.
.env*
!.env.example

# --- local agent state ------------------------------------------------------
# Superpowers/SDD scratch state, worktrees and local-only settings.
/.superpowers/
.claude/settings.local.json

# --- logs -------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- editors / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# --- misc -------------------------------------------------------------------
*.pem
.vercel
