# claude-web — environment
#
# Copy to `.env` (gitignored) and fill in the two Clerk keys. Everything else
# has a working default; see README.md for what each one does.
#
# Both keys come from the SAME Clerk application (Dashboard → API keys).
# Creating a second application is never required.

# --- Required ---------------------------------------------------------------
# Clerk secret key. Server-only: never import it into a Client Component and
# never give it a NEXT_PUBLIC_ prefix.
CLERK_SECRET_KEY=sk_test_...

# Clerk publishable key. Safe for the browser by design; still checked at boot
# so a swapped pair fails immediately instead of at the sign-in screen.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Optional (defaults shown) ---------------------------------------------
# SQLite database. Its directory is created at boot and pinned to mode 0700,
# the file to 0600. `data/` is gitignored.
# DATABASE_PATH=./data/claude-web.db

# Where the server listens. `npm start` and `npm run dev` read these from this
# file and pass them to Next as flags — `next start` run directly listens on
# every interface (0.0.0.0) regardless of these. Keep localhost unless a
# reverse proxy fronts the app.
# Use the name "localhost", not 127.0.0.1: Next normalizes loopback request
# hosts to "localhost" and compares proxy rewrites against an origin built from
# this value, so a different spelling makes same-origin rewrites look external.
# HOST=localhost
# PORT=3000

# Trust X-Forwarded-For / X-Forwarded-Proto from the direct peer. Set true ONLY
# when a reverse proxy you control is the only route in; otherwise a client can
# forge both headers (rate-limit keys, HSTS).
# TRUST_PROXY=false

# Directories a conversation's working directory may resolve inside. Comma
# separated, absolute, symlink-resolved. Empty = no usable cwd, so chat cannot
# send a turn.
# ALLOWED_WORKSPACE_ROOTS=/home/ubuntu/projects,/home/ubuntu/claude-web

# "auto" means the CLI's own default (no model override).
# DEFAULT_MODEL=auto

# Concurrent agent sessions (each can use ~1 GiB). Oldest is evicted and can be
# resumed later.
# MAX_CONCURRENT_TURNS=2

# Hard stop for a single turn that keeps streaming. Milliseconds.
# TURN_TIMEOUT_MS=1800000

# Adapters that may be activated. Only `claude` has an adapter in this build;
# the other names are accepted but refused until their adapter ships.
# ENABLED_PROVIDERS=claude

# Optional path to a Claude Code binary. Leave empty: the Agent SDK bundles its
# own copy, and the host login is inherited either way.
# CLAUDE_EXECUTABLE=

# Optional narrowing of what Integrations may install. When this key is ABSENT
# (the default) the page installs the registry's exact pins — currently
# `@openai/codex@0.167.0,@opencode/cli@2.2.6,@qoder-ai/qodercli@1.1.86`.
# Set it to a comma-separated list of exact specs to offer only those.
# Set it to an empty value (`INSTALL_ALLOWLIST=`) to disable server-side
# installs entirely; the page then only detects what is already on the host.
# INSTALL_ALLOWLIST=
